.PHONY: setup dev build test typecheck db-up db-down db-reset db-migrate db-seed db-seed-live db-studio

## Install deps, start Postgres, apply migrations, seed the demo account.
setup:
	npm install
	docker compose up -d
	@echo "waiting for Postgres to accept connections..."
	@sleep 3
	npx prisma migrate deploy
	npx tsx prisma/seed.ts
	@echo ""
	@echo "Ready. Run 'make dev' and open http://localhost:3000"
	@echo "Sign in with 'Look around the demo', or demo@example.com / demo123"

dev:
	npm run dev

build:
	npm run build

test:
	npm test

typecheck:
	npm run typecheck

db-up:
	docker compose up -d

db-down:
	docker compose down

## Wipe the database and rebuild it from scratch.
db-reset:
	docker compose down -v
	docker compose up -d
	@sleep 3
	npx prisma migrate deploy
	npx tsx prisma/seed.ts

## Create a new migration after editing prisma/schema.prisma.
db-migrate:
	npx prisma migrate dev

db-seed:
	npx tsx prisma/seed.ts

## Seed with roadmaps, week, and reviews generated by the real agents (needs ANTHROPIC_API_KEY).
db-seed-live:
	SEED_LIVE=true npx tsx prisma/seed.ts

db-studio:
	npx prisma studio
