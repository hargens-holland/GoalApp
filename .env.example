# Copy this file to `.env` and fill in the values.
#   cp .env.example .env
#
# `.env` is gitignored and must never be committed.

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# Local development via `docker compose up -d` uses the URL below as-is.
# In production, use the POOLED connection string from your Postgres provider.
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/goalplanner"

# Direct (unpooled) connection, used only by `prisma migrate`. Locally this is
# the same as DATABASE_URL; on a serverless host it is the provider's direct
# endpoint, because migrations cannot run through a transaction pooler.
DIRECT_URL="postgresql://postgres:postgres@localhost:5434/goalplanner"

# ---------------------------------------------------------------------------
# Auth (required)
# ---------------------------------------------------------------------------
# Secret used to sign JWT session tokens. Must be a random 32+ char string.
# Generate one with:  openssl rand -base64 32
NEXTAUTH_SECRET="replace-me-with-openssl-rand-base64-32"

# The app's own base URL. Must match the deployed origin exactly.
NEXTAUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# LLM integration (optional)
# ---------------------------------------------------------------------------
# API key for the Anthropic API, used by the three planning agents.
#
# Leave this BLANK to run the app in demo mode: every agent falls back to
# deterministic, hand-written planning logic. The full product works end to
# end with no key and no network calls — see "Demo mode" in the README.
ANTHROPIC_API_KEY=""

# Force demo mode even when ANTHROPIC_API_KEY is set.
# The public demo deployment sets this to "true" so that a shared, unauthenticated
# environment can never spend real API credits.
DEMO_MODE="false"

# Shows the "Explore the demo" one-click sign-in button on the login page.
# Set to "true" wherever the seeded demo account exists (local dev and the
# public demo). Must be NEXT_PUBLIC_* because it is read in the browser.
NEXT_PUBLIC_DEMO_MODE="true"

# Model used for all agent calls. Optional; defaults to claude-opus-4-8.
# ANTHROPIC_MODEL="claude-opus-4-8"
